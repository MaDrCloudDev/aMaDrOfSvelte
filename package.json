{
	"name": "amadrofsvelte",
	"version": "3.0.0",
	"private": true,
	"description": "A small, decisive full-stack SvelteKit starter: Better Auth, Drizzle, Turso, Tailwind 4 and shadcn-svelte.",
	"keywords": [
		"sveltekit",
		"better-auth",
		"auth",
		"template",
		"turso",
		"drizzle",
		"shadcn-svelte",
		"tailwind",
		"svelte",
		"sveltekit-template",
		"starter"
	],
	"license": "MIT",
	"author": "MaDr (https://github.com/MaDrCloudDev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MaDrCloudDev/aMaDrOfSvelte.git"
	},
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:ui": "vitest --ui",
		"validate": "bun run check && bun run lint && bun run test:run && bun run build",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"better-auth": "^1.7.28",
		"drizzle-orm": "^0.45.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.81.0",
		"@sveltejs/adapter-vercel": "^7.0.5",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "^26.6.11",
		"@vitest/ui": "^5.1.2",
		"bits-ui": "^2.22.0",
		"clsx": "^2.1.1",
		"dotenv": "^18.0.10",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.4.0",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.2"
	}
}
